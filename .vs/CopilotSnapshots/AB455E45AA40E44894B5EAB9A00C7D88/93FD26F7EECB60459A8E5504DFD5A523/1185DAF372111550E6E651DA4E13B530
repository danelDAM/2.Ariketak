    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();

            kaxak = new TextBox[3] { lehenengoTestua, bigarrengoTestua, hirugarrengoTestua };
        }

        TextBox[] kaxak;
        string testua = "";

        private void enter (object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter)
            {
                TextBox actual = (TextBox)sender;

                int posizioa = Array.IndexOf(kaxak, actual);
                int hurregoPosizioa = (posizioa +1) % kaxak.Length;

                kaxak[hurregoPosizioa].Text = actual.Text;
                actual.Clear();
                kaxak[hurregoPosizioa].Focus();

            }
        }

        private void garbitu (object sender, RoutedEventArgs e)
        {
           TextBox actual.Text = "";
        }

        private void irten(object sender, RoutedEventArgs e)
        {
            Application.Current.Shutdown();
        }
}